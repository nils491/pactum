{
  "name": "tactus",
  "private": true,
  "version": "3.1.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check": "node scripts/check.mjs",
    "db:migrate:local": "wrangler d1 migrations apply tactus --local",
    "db:migrate:remote": "wrangler d1 migrations apply tactus --remote"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/jetbrains-mono": "^5.0.0",
    "@fontsource/plus-jakarta-sans": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "wrangler": "^4.0.0"
  }
}
