{
  // TACTUS · Cloudflare Worker mit statischen Assets (kostenloser Plan)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tactus",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  // Domain direkt an diesen Worker binden (legt die DNS-Einträge bei Cloudflare selbst an)
  "routes": [
    { "pattern": "tactus.digital", "custom_domain": true },
    { "pattern": "www.tactus.digital", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tactus",
      "database_id": "0e6700fb-c826-475b-acc7-d5a837740d89",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "AI_DAILY_TEXT": "150",
    "AI_DAILY_TTS": "150",
    "MAIL_FROM_EMAIL": "noreply@tactus.digital",
    "MAIL_FROM_NAME": "TACTUS",
    "MAIL_OPERATOR": "kontakt@tactus.digital"
  },
  "observability": { "enabled": true }
  // Secrets (nicht hier eintragen!): GEMINI_API_KEY, ADMIN_TOKEN, BREVO_API_KEY
}
